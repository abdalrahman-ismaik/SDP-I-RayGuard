<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only">
  <info>
    <title>IEEE-like numeric (minimal, local)</title>
    <id>local-ieee-min</id>
    <updated>2026-11-23T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="none"/>
      <et-al font-style="italic"/>
    </names>
  </macro>
  <macro name="container">
    <choose>
      <if type="paper-conference">
        <group delimiter=" ">
          <text value="in"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </if>
      <else-if type="article-journal">
        <text variable="container-title" font-style="italic"/>
      </else-if>
      <else>
        <text variable="publisher"/>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title" quotes="true"/>
        <text macro="container"/>
        <group delimiter=" ">
          <text term="volume" form="short"/>
          <text variable="volume"/>
        </group>
        <group delimiter=" ">
          <text term="issue" form="short"/>
          <text variable="issue"/>
        </group>
        <group delimiter=" ">
          <text term="page" form="short"/>
          <text variable="page"/>
        </group>
        <date variable="issued"><date-part name="year"/></date>
        <text variable="DOI" prefix="doi: "/>
        <text variable="URL" prefix="[Online]. Available: "/>
        <text variable="note"/>
      </group>
    </layout>
  </bibliography>
</style>
